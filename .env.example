# Copy this file to .env and adjust the values.
# Environment variables take precedence over .env,
# and command-line arguments take precedence over both.

# URL of a large file to download, e.g. a heavy image
SPEEDMETER_URL=https://upload.wikimedia.org/wikipedia/commons/f/ff/Pizigani_1367_Chart_10MB.jpg

# Number of sequential requests
SPEEDMETER_REQUESTS=10

# Timeout in seconds for connecting and for each read
# (it does not limit the whole download)
SPEEDMETER_TIMEOUT=30
